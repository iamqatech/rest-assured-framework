pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean test "-DsuiteXmlFile=testng.xml"'
            }
        }
		}

    post {
        always {
            echo 'Test execution completed'
			junit 'target/surefire-reports/*.xml'
        }
		

        success {
        emailext(
            to: 'tech.prashants@gmail.com',
            subject: "[${params.ENV}] API Automation PASSED - Build #${env.BUILD_NUMBER}",
            body: """
API Automation Test Execution PASSED

Job         : ${env.JOB_NAME}
Build       : #${env.BUILD_NUMBER}
Environment : ${params.ENV}
Status      : PASSED

Check Jenkins for details:
${env.BUILD_URL}
""",
            attachmentsPattern: 'target/surefire-reports/*.xml'
        )
    }
	
failure {
        emailext(
            to: 'tech.prashants@gmail.com',
            subject: "[${params.ENV}] API Automation FAILED - Build #${env.BUILD_NUMBER}",
            body: """
API Automation Test Execution Failed

Job         : ${env.JOB_NAME}
Build       : #${env.BUILD_NUMBER}
Environment : ${params.ENV}
Status      : FAILED

Check Jenkins for details:
${env.BUILD_URL}
""",
            attachmentsPattern: 'target/surefire-reports/*.xml'
        )
    }
		
    }
}