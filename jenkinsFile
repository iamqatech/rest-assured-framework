pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean test "-DsuiteXmlFile=testng.xml"'
            }
        }
		
		stage('Check Agent'){
		steps {sh 'sname -a'}
    }

    post {
        always {
            echo 'Test execution completed'
        }

        success {
            echo 'API Tests PASSED'
        }

        failure {
            echo 'API Tests FAILED'
        }
    }
}