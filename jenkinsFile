pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean test "-DsuiteXmlFile=testng.xml"'
            }
        }
		}

    post {
        always {
            echo 'Test execution completed'
			junit 'target/surefire-reports/*.xml'
        }
		
success {
        mail(
            to: 'tech.prashants@gmail.com',
            subject: "API Automation - SUCCESS - Build #${env.BUILD_NUMBER}",
            body: """
API Automation Execution Successful

Job        : ${env.JOB_NAME}
Build      : #${env.BUILD_NUMBER}
Environment: TEST
Status     : SUCCESS

Jenkins Build:
${env.BUILD_URL}
"""
        )
    }

    failure {
        mail(
            to: 'tech.prashants@gmail.com',
            subject: "API Automation - FAILED - Build #${env.BUILD_NUMBER}",
            body: """
API Automation Execution FAILED

Job        : ${env.JOB_NAME}
Build      : #${env.BUILD_NUMBER}
Environment: TEST
Status     : FAILED

Please check the Jenkins console and test reports.

Jenkins Build:
${env.BUILD_URL}
"""
        )
    }
}}