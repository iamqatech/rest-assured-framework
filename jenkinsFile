pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean test "-DsuiteXmlFile=testng.xml"'
            }
        }
		}

    post {
        always {
            echo 'Test execution completed'
			junit 'target/surefire-reports/*.xml'
        }
		

        success {
            echo 'API Tests PASSED'
        }

        failure {
            echo 'API Tests FAILED'
        }
		
    }
}